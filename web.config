<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdoutLogEnabled="true" ve stdoutLogFile=".\db\stdout" ayarlayarak konsol çıktılarını ve IIS çökme hata günlüklerini "db" klasörüne yönlendiriyoruz -->
      <aspNetCore processPath="dotnet" arguments=".\mgtest.dll" stdoutLogEnabled="true" stdoutLogFile=".\db\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
