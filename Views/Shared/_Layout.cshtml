<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - mgtest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/mgtest.styles.css" asp-append-version="true" />
</head>
<body>
    @using Microsoft.AspNetCore.Http
    @inject IHttpContextAccessor HttpContextAccessor

    @if (HttpContextAccessor.HttpContext?.Session.GetInt32("KullaniciId") != null)
    {
        <header>
            
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-mortarboard-fill"></i> mgtest
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/mgtest/CreateBank"><i class="bi bi-journal-plus"></i> Soru Bankası Hazırla</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/mgtest/Cart"><i class="bi bi-cart3"></i> Sepetim</a>
                            </li>
                            @if (HttpContextAccessor.HttpContext?.Session.GetString("KullaniciTuru") == "admin")
                            {
                                <li class="nav-item border-start ms-2 ps-2">
                                    <a class="nav-link text-danger fw-bold" href="/Admin/Kullanicilar"><i class="bi bi-shield-lock"></i> Yönetici Paneli</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" href="/Admin/DosyaLoglari"><i class="bi bi-journal-text"></i> Şifreli Dosya Logları</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" href="/Admin/SiteLoglari"><i class="bi bi-activity"></i> Site Logları</a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav align-items-center">
                            @{
                                var kTur = HttpContextAccessor.HttpContext?.Session.GetString("KullaniciTuru");
                                var skTarih = HttpContextAccessor.HttpContext?.Session.GetString("SonKullanmaTarihi");
                                
                                // Son kullanma tarihi geçmiş mi kontrolü (basit görsel uyarı)
                                bool isExpired = false;
                                if (!string.IsNullOrEmpty(skTarih) && DateTime.TryParseExact(skTarih, "dd.MM.yyyy", null, System.Globalization.DateTimeStyles.None, out DateTime dt))
                                {
                                    if (dt < DateTime.Now) isExpired = true;
                                }
                            }
                            @if (kTur == "kisitliUser")
                            {
                                <li class="nav-item me-3">
                                    <span class="badge @(isExpired ? "bg-danger" : "bg-warning text-dark")">
                                        <i class="bi bi-exclamation-triangle"></i> Kısıtlı Kullanıcı
                                    </span>
                                    <small class="@(isExpired ? "text-danger fw-bold" : "text-muted") ms-1">Bitiş: @(skTarih ?? "Belirsiz")</small>
                                </li>
                            }
                            else if (kTur != null)
                            {
                                <li class="nav-item me-3">
                                    <span class="badge bg-info text-dark">@kTur.ToUpper()</span>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-muted" href="/Account/Logout">
                                    <i class="bi bi-box-arrow-right"></i> Çıkış Yap (@HttpContextAccessor.HttpContext?.Session.GetString("KullaniciAdi"))
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container-fluid px-md-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid px-md-4">
            &copy; 2025 - mgtest
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    @if (HttpContextAccessor.HttpContext?.Session.GetInt32("KullaniciId") != null)
    {
        <!-- Yüzen Sepet Butonu -->
        <a href="/mgtest/Cart" id="yuzenSepetBtn" class="yuzen-sepet shadow-lg" style="position: fixed; bottom: 120px; right: 30px; z-index: 9999; width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #764ba2 0%, #667eea 100%); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: transform 0.3s ease, box-shadow 0.3s ease; box-shadow: 0 10px 20px rgba(0,0,0,0.19), 0 6px 6px rgba(0,0,0,0.23);">
            <i class="bi bi-cart-fill text-white fs-3"></i>
            <span id="yuzenSepetBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none; font-size: 0.8rem; padding: 0.35em 0.65em;">0</span>
        </a>
    }

    <style>
        .yuzen-sepet:hover {
            transform: scale(1.1);
            box-shadow: 0 14px 28px rgba(0,0,0,0.25), 0 10px 10px rgba(0,0,0,0.22);
        }
    </style>

    <script>
        function guncelleYuzenSepetBadge() {
            try {
                const sepetSorularRaw = localStorage.getItem("sepetSorular");
                const badge = document.getElementById("yuzenSepetBadge");
                if (badge) {
                    if (sepetSorularRaw) {
                        const sepetSorular = JSON.parse(sepetSorularRaw);
                        if (Array.isArray(sepetSorular) && sepetSorular.length > 0) {
                            badge.textContent = sepetSorular.length;
                            badge.style.display = "block";
                            return;
                        }
                    }
                    badge.style.display = "none";
                }
            } catch (e) {
                console.error("Sepet badge güncelleme hatası:", e);
            }
        }
        document.addEventListener("DOMContentLoaded", () => {
            guncelleYuzenSepetBadge();

            // Sürüklenebilir Yüzen Sepet Butonu
            const dragBtn = document.getElementById("yuzenSepetBtn");
            if (dragBtn) {
                let isDragging = false;
                let startX, startY;
                let initialX, initialY;

                dragBtn.addEventListener("mousedown", (e) => {
                    isDragging = false;
                    startX = e.clientX;
                    startY = e.clientY;
                    
                    const rect = dragBtn.getBoundingClientRect();
                    initialX = rect.left;
                    initialY = rect.top;

                    dragBtn.style.transition = "none";
                    
                    document.addEventListener("mousemove", onMouseMove);
                    document.addEventListener("mouseup", onMouseUp);
                });

                dragBtn.addEventListener("touchstart", (e) => {
                    isDragging = false;
                    if (e.touches.length === 1) {
                        startX = e.touches[0].clientX;
                        startY = e.touches[0].clientY;
                        const rect = dragBtn.getBoundingClientRect();
                        initialX = rect.left;
                        initialY = rect.top;
                        dragBtn.style.transition = "none";
                        document.addEventListener("touchmove", onTouchMove, { passive: false });
                        document.addEventListener("touchend", onTouchEnd);
                    }
                }, { passive: true });

                function onMouseMove(e) {
                    const dx = e.clientX - startX;
                    const dy = e.clientY - startY;
                    if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
                        isDragging = true;
                    }
                    if (isDragging) {
                        dragBtn.style.left = (initialX + dx) + "px";
                        dragBtn.style.top = (initialY + dy) + "px";
                        dragBtn.style.right = "auto";
                        dragBtn.style.bottom = "auto";
                    }
                }

                function onMouseUp(e) {
                    document.removeEventListener("mousemove", onMouseMove);
                    document.removeEventListener("mouseup", onMouseUp);
                    
                    dragBtn.style.transition = "transform 0.3s ease, box-shadow 0.3s ease";
                    
                    if (isDragging) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                }

                function onTouchMove(e) {
                    if (e.touches.length === 1) {
                        const dx = e.touches[0].clientX - startX;
                        const dy = e.touches[0].clientY - startY;
                        if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
                            isDragging = true;
                            if (e.cancelable) e.preventDefault();
                        }
                        if (isDragging) {
                            dragBtn.style.left = (initialX + dx) + "px";
                            dragBtn.style.top = (initialY + dy) + "px";
                            dragBtn.style.right = "auto";
                            dragBtn.style.bottom = "auto";
                        }
                    }
                }

                function onTouchEnd(e) {
                    document.removeEventListener("touchmove", onTouchMove);
                    document.removeEventListener("touchend", onTouchEnd);
                    dragBtn.style.transition = "transform 0.3s ease, box-shadow 0.3s ease";
                    if (isDragging) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                }

                dragBtn.addEventListener("click", (e) => {
                    if (isDragging) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                });
            }
        });
        window.addEventListener("storage", guncelleYuzenSepetBadge);
        window.addEventListener("updateCartBadge", guncelleYuzenSepetBadge);
    </script>
</body>
</html>
