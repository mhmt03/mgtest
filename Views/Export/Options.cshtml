@{
    ViewData["Title"] = "Dosya Oluştur";
    var sessionKey = ViewBag.SessionKey;
    var secilenIds = ViewBag.SecilenIds;
    var bankaAdi = ViewBag.BankaAdi;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .navbar-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .btn-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
        }

        .export-card {
            border-left: 4px solid #667eea;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Sorular", "Soru", new { sessionKey })">
                <i class="fas fa-arrow-left"></i> Geri
            </a>
            <span class="navbar-text text-white">
                <h5 class="mb-0">📄 Dosya Oluştur</h5>
            </span>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="card export-card">
                    <div class="card-header bg-danger text-white">
                        <h5><i class="fas fa-file-pdf"></i> PDF Oluştur</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="GeneratePdf">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sessionKey" value="@sessionKey" />
                            <input type="hidden" name="secilenIds" value="@secilenIds" />

                            <div class="mb-3">
                                <label class="form-label">Sütun Sayısı</label>
                                <select name="sutunSayisi" class="form-select">
                                    <option value="1">1 Sütun</option>
                                    <option value="2" selected>2 Sütun</option>
                                    <option value="3">3 Sütun</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Üst Bilgi (Header)</label>
                                <input type="text" name="header" class="form-control"
                                       value="@ViewBag.VarsayilanHeader"
                                       placeholder="Örn: 2024-2025 Deneme Sınavı" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Alt Bilgi (Footer)</label>
                                <input type="text" name="footer" class="form-control"
                                       value="@ViewBag.VarsayilanFooter"
                                       placeholder="Örn: www.example.com" />
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="anahtarEkle"
                                       id="pdfAnahtar" checked="@ViewBag.VarsayilanAnahtar" value="true">
                                <label class="form-check-label" for="pdfAnahtar">
                                    Cevap Anahtarı Ekle
                                </label>
                            </div>

                            <button type="submit" class="btn btn-danger w-100">
                                <i class="fas fa-file-pdf"></i> PDF İndir
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="card export-card">
                    <div class="card-header bg-primary text-white">
                        <h5><i class="fas fa-file-word"></i> Word Belgesi Oluştur</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="GenerateDocx">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sessionKey" value="@sessionKey" />
                            <input type="hidden" name="secilenIds" value="@secilenIds" />

                            <div class="mb-3">
                                <label class="form-label">Sütun Sayısı</label>
                                <select name="sutunSayisi" class="form-select">
                                    <option value="1">1 Sütun</option>
                                    <option value="2" selected>2 Sütun</option>
                                    <option value="3">3 Sütun</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Üst Bilgi (Header)</label>
                                <input type="text" name="header" class="form-control"
                                       value="@ViewBag.VarsayilanHeader"
                                       placeholder="Örn: 2024-2025 Deneme Sınavı" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Alt Bilgi (Footer)</label>
                                <input type="text" name="footer" class="form-control"
                                       value="@ViewBag.VarsayilanFooter"
                                       placeholder="Örn: www.example.com" />
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="anahtarEkle"
                                       id="docxAnahtar" checked="@ViewBag.VarsayilanAnahtar" value="true">
                                <label class="form-check-label" for="docxAnahtar">
                                    Cevap Anahtarı Ekle
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-file-word"></i> DOCX İndir
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-info">
            <h6><i class="fas fa-info-circle"></i> Bilgi:</h6>
            <ul class="mb-0">
                <li>Seçili sorular dosyaya eklenecektir</li>
                <li>Resimler otomatik olarak dahil edilecek</li>
                <li>Cevap anahtarı ayrı sayfada gösterilecek</li>
                <li>Sütun sayısı Word'de düzenlenebilir</li>
            </ul>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>