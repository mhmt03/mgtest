@{
    ViewData["Title"] = "Yabancı Soru Bankası Dönüştürücü";
}

<div class="container py-4">
    <!-- Başlık ve Tanıtım -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-arrow-repeat text-primary me-2"></i>Yabancı Soru Bankası Dönüştürücü
            </h2>
            <p class="text-muted mb-0">
                Farklı soru bankası uygulamalarının veritabanı dosyalarını (<code>.hzb</code>, <code>.db</code>, <code>.sqlite</code> vb.) 
                okuyup <strong>.mg</strong> biçimine dönüştürün.
            </p>
        </div>
        <div class="text-end">
            <span class="badge bg-danger px-3 py-2 fs-6 mb-1 d-inline-block">
                <i class="bi bi-shield-lock me-1"></i>Sadece Admin
            </span>
            <div>
                <a href="@Url.Action("Kullanicilar", "Admin")" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Yönetici Paneli
                </a>
            </div>
        </div>
    </div>

    <!-- Hızlı Şablonlar ve Bilgi Kartı -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-lightning-charge-fill text-warning fs-4 me-2"></i>
                        <div>
                            <strong>Hızlı Şablonlar:</strong>
                            <span class="text-muted small ms-1">Sık kullanılan uygulamalar için alanları tek tıkla otomatik doldurun.</span>
                        </div>
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="applyHzbPreset()">
                            <i class="bi bi-check-circle me-1"></i>HZB (.hzb) Şablonunu Doldur
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearFormFields()">
                            <i class="bi bi-eraser me-1"></i>Alanları Temizle
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form id="convertForm" enctype="multipart/form-data">
        <div class="row g-4">
            <!-- Sol Kolon: Dosya Yükleme & Şema Bilgisi -->
            <div class="col-lg-5">
                <!-- Dosya Seçim Kartı -->
                <div class="card shadow-sm border-0 mb-4 h-100">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title mb-0 fw-bold">
                            <i class="bi bi-file-earmark-arrow-up text-primary me-2"></i>1. Hedef Dosyayı Seçin
                        </h5>
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="mb-3">
                                <label for="targetFile" class="form-label fw-semibold">Kaynak Veritabanı Dosyası</label>
                                <input class="form-control form-control-lg" type="file" id="targetFile" name="dosya" 
                                       accept=".hzb,.db,.sqlite,.sqlite3,.dat,.mg" required onchange="onFileSelected(this)">
                                <div class="form-text">
                                    Desteklenenler: <code>.hzb</code>, <code>.db</code>, <code>.sqlite</code>, <code>.sqlite3</code> vb.
                                </div>
                            </div>

                            <div id="fileAnalyzeSpinner" class="alert alert-info py-2 d-none">
                                <div class="d-flex align-items-center">
                                    <div class="spinner-border spinner-border-sm me-2 text-info" role="status"></div>
                                    <small>Dosya şeması analiz ediliyor...</small>
                                </div>
                            </div>

                            <!-- Şema Algılama Özeti -->
                            <div id="schemaSummaryBox" class="d-none">
                                <h6 class="fw-bold text-success mb-2">
                                    <i class="bi bi-check2-circle me-1"></i>Dosyada Bulunan Tablolar:
                                </h6>
                                <div id="schemaTablesContainer" class="list-group list-group-flush border rounded-3 p-2 small bg-white" style="max-height: 250px; overflow-y: auto;">
                                </div>
                                <div class="text-muted small mt-2">
                                    <i class="bi bi-info-circle me-1"></i>Tablolara tıklayarak ilgili adı sağdaki forma otomatik aktarabilirsiniz.
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning border-0 mt-4 mb-0 small">
                            <i class="bi bi-shield-exclamation me-1"></i>
                            <strong>Önemli Kural:</strong> Sistem sadece eşleştirdiğiniz kolonları çeker. Bizim veri tabanımızda olmayan yabancı kolonlar otomatik olarak <strong>yoksayılır (ignore)</strong>.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sağ Kolon: Tablo ve Kolon Eşleştirme Formu -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title mb-0 fw-bold">
                            <i class="bi bi-sliders text-primary me-2"></i>2. Tablo ve Kolon Eşleştirmeleri
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Temel Ayarlar -->
                        <div class="row g-3 mb-4 pb-3 border-bottom">
                            <div class="col-md-6">
                                <label for="bankaAdi" class="form-label fw-semibold">Yeni Banka Adı (.mg için) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="bankaAdi" name="BankaAdi" value="DonusturulenBanka" required>
                            </div>
                            <div class="col-md-6">
                                <label for="varsayilanDersAdi" class="form-label fw-semibold">Varsayılan Ders Adı</label>
                                <input type="text" class="form-control" id="varsayilanDersAdi" name="VarsayilanDersAdi" value="Genel">
                            </div>
                        </div>

                        <!-- Soru Tablosu & Zorunlu Alanlar -->
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-question-circle me-1"></i>Soru Tablosu ve Temel Kolonlar
                        </h6>
                        <div class="row g-3 mb-4 pb-3 border-bottom">
                            <div class="col-md-6">
                                <label for="soruTabloAdi" class="form-label fw-semibold">Soru Tablosu Adı <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="soruTabloAdi" name="SoruTabloAdi" value="SORULAR" required placeholder="Örn: SORULAR">
                            </div>
                            <div class="col-md-6">
                                <label for="soruMetniKolon" class="form-label fw-semibold">Soru Metni / Görsel Kolonu <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="soruMetniKolon" name="SoruMetniVeyaResmiKolon" value="Soru" required placeholder="Örn: Soru veya Question">
                                <div class="form-text small">Metin veya HTML / Base64 görsel içeren kolon.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="dogruCevapKolon" class="form-label fw-semibold">Doğru Cevap Kolonu</label>
                                <input type="text" class="form-control" id="dogruCevapKolon" name="DogruCevapKolon" value="DogruCevap" placeholder="Örn: DogruCevap veya Answer">
                                <div class="form-text small">1, 2.. (A, B..) veya harf olabilir.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="zorlukKolon" class="form-label fw-semibold">Zorluk Derecesi Kolonu</label>
                                <input type="text" class="form-control" id="zorlukKolon" name="ZorlukKolon" value="ZorlukDerecesi" placeholder="Örn: ZorlukDerecesi veya Difficulty">
                            </div>
                        </div>

                        <!-- Şık Kolonları (Opsiyonel) -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-primary mb-0">
                                <i class="bi bi-ui-checks me-1"></i>Ayrı Şık Kolonları (Opsiyonel)
                            </h6>
                            <small class="text-muted">Şıklar soru görseline gömülüyse boş bırakabilirsiniz.</small>
                        </div>
                        <div class="row g-2 mb-4 pb-3 border-bottom">
                            <div class="col">
                                <input type="text" class="form-control form-control-sm" id="sikAKolon" name="SikAKolon" value="Seçenek_1" placeholder="A Şıkkı">
                            </div>
                            <div class="col">
                                <input type="text" class="form-control form-control-sm" id="sikBKolon" name="SikBKolon" value="Seçenek_2" placeholder="B Şıkkı">
                            </div>
                            <div class="col">
                                <input type="text" class="form-control form-control-sm" id="sikCKolon" name="SikCKolon" value="Seçenek_3" placeholder="C Şıkkı">
                            </div>
                            <div class="col">
                                <input type="text" class="form-control form-control-sm" id="sikDKolon" name="SikDKolon" value="Seçenek_4" placeholder="D Şıkkı">
                            </div>
                            <div class="col">
                                <input type="text" class="form-control form-control-sm" id="sikEKolon" name="SikEKolon" value="Seçenek_5" placeholder="E Şıkkı">
                            </div>
                        </div>

                        <!-- Konu Eşleşmesi (Opsiyonel) -->
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-diagram-3 me-1"></i>Konu ve Ders Eşleşmesi (Opsiyonel)
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="soruKonuKolon" class="form-label fw-semibold">Sorular Tablosundaki Konu Kolonu</label>
                                <input type="text" class="form-control form-control-sm" id="soruKonuKolon" name="SoruKonuKolon" value="Konu" placeholder="Örn: Konu veya Topic">
                            </div>
                            <div class="col-md-6">
                                <label for="konuTabloAdi" class="form-label fw-semibold">Konu Tablosu Adı</label>
                                <input type="text" class="form-control form-control-sm" id="konuTabloAdi" name="KonuTabloAdi" value="KONULAR" placeholder="Örn: KONULAR">
                            </div>
                            <div class="col-md-6">
                                <label for="konuTabloIdKolon" class="form-label fw-semibold">Konu Tablosu ID / Kod Kolonu</label>
                                <input type="text" class="form-control form-control-sm" id="konuTabloIdKolon" name="KonuTabloIdKolon" value="konuNo" placeholder="Örn: konuNo veya id">
                            </div>
                            <div class="col-md-6">
                                <label for="konuTabloAdiKolon" class="form-label fw-semibold">Konu Tablosu Başlık Kolonu</label>
                                <input type="text" class="form-control form-control-sm" id="konuTabloAdiKolon" name="KonuTabloAdiKolon" value="konuAdi" placeholder="Örn: konuAdi veya name">
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light py-3 text-end">
                        <button type="submit" id="submitBtn" class="btn btn-primary btn-lg px-4 shadow-sm fw-bold">
                            <i class="bi bi-arrow-repeat me-1"></i> .mg Biçimine Dönüştür
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Sonuç / Başarı Alanı (Modal veya Alert) -->
    <div id="resultBox" class="mt-4 d-none">
        <div class="card border-0 shadow">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-check-circle-fill me-2"></i>Dönüştürme Başarılı!</h5>
                <span id="badgeQuestionCount" class="badge bg-light text-success fs-6"></span>
            </div>
            <div class="card-body p-4 text-center">
                <p id="resultMessage" class="fs-5 mb-4"></p>

                <div class="d-flex justify-content-center gap-3">
                    <a id="downloadBtn" href="#" class="btn btn-success btn-lg px-5 shadow-sm fw-bold">
                        <i class="bi bi-download me-2"></i>Dönüştürülen .mg Dosyasını İndir
                    </a>
                    <a href="@Url.Action("Index", "mgtest")" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-house me-1"></i>Soru Bankalarına Git
                    </a>
                </div>

                <div id="warningsBox" class="mt-4 text-start d-none">
                    <div class="alert alert-warning mb-0">
                        <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Uyarılar:</h6>
                        <ul id="warningsList" class="mb-0 small ps-3"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let discoveredSchema = null;

    // Hazır HZB Preset'i
    function applyHzbPreset() {
        document.getElementById('soruTabloAdi').value = 'SORULAR';
        document.getElementById('soruMetniKolon').value = 'Soru';
        document.getElementById('dogruCevapKolon').value = 'DogruCevap';
        document.getElementById('zorlukKolon').value = 'ZorlukDerecesi';
        
        document.getElementById('sikAKolon').value = 'Seçenek_1';
        document.getElementById('sikBKolon').value = 'Seçenek_2';
        document.getElementById('sikCKolon').value = 'Seçenek_3';
        document.getElementById('sikDKolon').value = 'Seçenek_4';
        document.getElementById('sikEKolon').value = 'Seçenek_5';
        
        document.getElementById('soruKonuKolon').value = 'Konu';
        document.getElementById('konuTabloAdi').value = 'KONULAR';
        document.getElementById('konuTabloIdKolon').value = 'konuNo';
        document.getElementById('konuTabloAdiKolon').value = 'konuAdi';

        const fileInput = document.getElementById('targetFile');
        if (fileInput.files.length > 0) {
            const fileName = fileInput.files[0].name.replace(/\.[^/.]+$/, "");
            document.getElementById('bankaAdi').value = fileName;
        }
    }

    // Formu Temizleme
    function clearFormFields() {
        document.getElementById('soruTabloAdi').value = '';
        document.getElementById('soruMetniKolon').value = '';
        document.getElementById('dogruCevapKolon').value = '';
        document.getElementById('zorlukKolon').value = '';
        document.getElementById('sikAKolon').value = '';
        document.getElementById('sikBKolon').value = '';
        document.getElementById('sikCKolon').value = '';
        document.getElementById('sikDKolon').value = '';
        document.getElementById('sikEKolon').value = '';
        document.getElementById('soruKonuKolon').value = '';
        document.getElementById('konuTabloAdi').value = '';
        document.getElementById('konuTabloIdKolon').value = '';
        document.getElementById('konuTabloAdiKolon').value = '';
    }

    // Dosya Seçildiğinde Şema Analizi Yap
    async function onFileSelected(input) {
        if (!input.files || input.files.length === 0) return;
        
        const file = input.files[0];
        const cleanName = file.name.replace(/\.[^/.]+$/, "");
        if (!document.getElementById('bankaAdi').value || document.getElementById('bankaAdi').value === 'DonusturulenBanka') {
            document.getElementById('bankaAdi').value = cleanName;
        }

        const spinner = document.getElementById('fileAnalyzeSpinner');
        const summaryBox = document.getElementById('schemaSummaryBox');
        const tablesContainer = document.getElementById('schemaTablesContainer');

        spinner.classList.remove('d-none');
        summaryBox.classList.add('d-none');
        tablesContainer.innerHTML = '';

        const formData = new FormData();
        formData.append('dosya', file);

        try {
            const res = await fetch('@Url.Action("SemaAnalizEt", "Admin")', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            spinner.classList.add('d-none');

            if (data.basarili && data.tablolar && data.tablolar.length > 0) {
                discoveredSchema = data.tablolar;
                summaryBox.classList.remove('d-none');

                data.tablolar.forEach(t => {
                    const item = document.createElement('div');
                    item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2';
                    item.style.cursor = 'pointer';
                    item.title = `Kolonlar: ${t.kolonlar.join(', ')}`;
                    item.innerHTML = `
                        <div>
                            <strong><i class="bi bi-table me-1 text-primary"></i>${t.tabloAdi}</strong>
                            <div class="text-muted" style="font-size: 11px;">${t.kolonlar.slice(0, 5).join(', ')}${t.kolonlar.length > 5 ? '...' : ''}</div>
                        </div>
                        <span class="badge bg-secondary rounded-pill">${t.satirSayisi} satır</span>
                    `;
                    item.onclick = () => {
                        document.getElementById('soruTabloAdi').value = t.tabloAdi;
                    };
                    tablesContainer.appendChild(item);
                });
            }
        } catch (err) {
            spinner.classList.add('d-none');
            console.error('Şema analizi hatası:', err);
        }
    }

    // Dönüştürme Form Gönderimi
    document.getElementById('convertForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const fileInput = document.getElementById('targetFile');
        if (!fileInput.files || fileInput.files.length === 0) {
            alert('Lütfen bir hedef veritabanı dosyası seçin!');
            return;
        }

        const btn = document.getElementById('submitBtn');
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Dönüştürülüyor...';

        const resultBox = document.getElementById('resultBox');
        resultBox.classList.add('d-none');

        const formData = new FormData(this);

        try {
            const response = await fetch('@Url.Action("BankaDonustur", "Admin")', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();
            btn.disabled = false;
            btn.innerHTML = originalText;

            if (result.basarili) {
                resultBox.classList.remove('d-none');
                document.getElementById('badgeQuestionCount').textContent = `${result.donusturulenSoruSayisi} Soru`;
                document.getElementById('resultMessage').innerHTML = `<strong>Tebrikler!</strong> ${result.mesaj}`;
                
                const dlBtn = document.getElementById('downloadBtn');
                dlBtn.href = result.downloadUrl;
                dlBtn.download = result.dosyaAdi || 'banka.mg';

                // Otomatik indirmeyi tetikle
                setTimeout(() => {
                    dlBtn.click();
                }, 500);

                // Uyarılar varsa göster
                const warnBox = document.getElementById('warningsBox');
                const warnList = document.getElementById('warningsList');
                warnList.innerHTML = '';
                if (result.uyariListesi && result.uyariListesi.length > 0) {
                    warnBox.classList.remove('d-none');
                    result.uyariListesi.forEach(w => {
                        const li = document.createElement('li');
                        li.textContent = w;
                        warnList.appendChild(li);
                    });
                } else {
                    warnBox.classList.add('d-none');
                }

                // Sayfayı sonuç kutusuna kaydır
                resultBox.scrollIntoView({ behavior: 'smooth' });
            } else {
                alert('Dönüştürme Hatası: ' + result.mesaj);
            }
        } catch (error) {
            btn.disabled = false;
            btn.innerHTML = originalText;
            alert('Sunucuyla iletişim kurulurken bir hata oluştu: ' + error.message);
        }
    });
</script>
