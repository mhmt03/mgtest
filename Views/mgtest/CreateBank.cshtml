                        <span class="small fw-bold">Ders:</span>
                        <select class="form-select form-select-sm" id="pdfDersSelect" style="min-width: 150px; width: auto;">
                            <option value="">Ders Seçin</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-1">
