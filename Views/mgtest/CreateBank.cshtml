                            <select class="form-select form-select-sm border-0 text-primary fw-bold" id="pdfQualitySelect" style="width: auto; background-color: transparent;">
                                <option value="1.0">Düşük (Hızlı)</option>
                                <option value="1.5">Standart</option>
