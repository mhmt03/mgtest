@{
    ViewData["Title"] = "Yeni Soru Bankası Oluştur";
    // SHIELD_ENCRYPTION_START
    var sifre = ViewData["Sifre"] as string;
    // SHIELD_ENCRYPTION_END
}
 
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />
    
    <!-- Cropper.js CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet" />
    
    <!-- Özel CSS -->
    <link href="~/css/soru-bankasi.css" rel="stylesheet" />
</head>

<body>
    @* CSRF Token - Gizli input olarak ekleyin *@

    

    <input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()" />
    
    <div class="container-fluid mt-4">
        
        <!-- HEADER BÖLÜMÜ -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0 rounded-custom">
                    <div class="card-body p-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 12px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="mb-1">
                                    <i class="bi bi-journal-plus"></i> Yeni Soru Bankası Oluştur
                                </h2>
                                <p class="mb-0 opacity-75">Sorularınızı ekleyin ve düzenleyin</p>
                            </div>
                            <a href="/mgtest/Index" class="btn btn-light btn-lg">
                                <i class="bi bi-house"></i> Anasayfa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- BANKA ADI VE KONTROL BUTONLARI -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="row align-items-end">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label for="bankaAdi" class="form-label fw-bold">
                                    <i class="bi bi-folder"></i> Banka Adı *
                                </label>
                                <input type="text" 
                                       class="form-control form-control-lg" 
                                       id="bankaAdi" 
                                       placeholder="Örn: 2024 Matematik Sorular">
                            </div>
                            <div class="col-md-8">
                                <div class="d-flex gap-2 flex-wrap">
                                    <button class="btn btn-info" id="dersEkleBtn">
                                        <i class="bi bi-folder-plus"></i> Ders Yönetimi
                                    </button>
                                    <button class="btn btn-success" id="soruEkleBtn">
                                        <i class="bi bi-plus-circle"></i> Soru Ekle
                                    </button>
                                    <button class="btn btn-warning" id="pdfSeriSoruEkleBtn">
                                        <i class="bi bi-file-pdf"></i> PDF'ten Seri Soru Ekle
                                    </button>
                                    <button class="btn btn-primary" id="bankaKaydetBtn">
                                        <i class="bi bi-save"></i> Bankayı Kaydet ve İndir
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOPLU İŞLEMLER -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h6 class="card-title text-primary">
                    <i class="bi bi-stack"></i> Toplu İşlemler
                </h6>
                <div class="row g-3">
                    <div class="col-md-6 border-end">
                        <p class="text-muted small mb-2"><strong>Soru Ekleme:</strong> Klasördeki tüm resimleri metinsiz soru olarak ekler.</p>
                        <button class="btn btn-outline-primary btn-sm" onclick="document.getElementById('topluKlasorInput').click()">
                            <i class="bi bi-folder-plus"></i> Klasörden Toplu Soru Ekle
                        </button>
                        <input type="file" id="topluKlasorInput" webkitdirectory directory multiple style="display:none" 
                               onchange="topluKlasorSoruEkle(event)" />
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-2"><strong>Anahtar Yönetimi:</strong> Excel ile cevap anahtarı ve kazanımları güncelleyin.</p>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-info btn-sm" onclick="topluAnahtarSablonIndir()">
                                <i class="bi bi-file-earmark-excel"></i> Excel Şablonu İndir
                            </button>
                            <button class="btn btn-outline-success btn-sm" onclick="document.getElementById('topluExcelInput').click()">
                                <i class="bi bi-upload"></i> Excel Yükle
                            </button>
                            <input type="file" id="topluExcelInput" accept=".xlsx" style="display:none" 
                                   onchange="topluExcelYukle(event)" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOPLU SORU EKLEME MODAL (KALİTE SEÇİMİ) -->
        <div class="modal fade" id="topluSoruKaliteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Toplu Soru Yükleme Ayarları</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Yüklenecek resimlerin maksimum genişliğini seçin. Düşük genişlik daha az yer kaplar ve sistemi hızlandırır.</p>
                        <div class="list-group">
                            <button type="button" class="list-group-item list-group-item-action" onclick="topluKlasorBaslat(800)">
                                <b>800px (Önerilen)</b> - Hızlı ve optimize
                            </button>
                            <button type="button" class="list-group-item list-group-item-action" onclick="topluKlasorBaslat(1200)">
                                <b>1200px</b> - Yüksek kalite
                            </button>
                            <button type="button" class="list-group-item list-group-item-action" onclick="topluKlasorBaslat(1600)">
                                <b>1600px</b> - Çok yüksek kalite
                            </button>
                            <button type="button" class="list-group-item list-group-item-action text-danger" onclick="topluKlasorBaslat('unlimited')">
                                <b>Sınırsız</b> - Orijinal kalite (Yavaş yükleme)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- EXPORT BÖLÜMÜ -->
        <div class="export-section">
            <h5 class="mb-3">
                <i class="bi bi-file-earmark-arrow-down"></i> Dışa Aktarma Seçenekleri
            </h5>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <input id="pdfBaslik" 
                           class="form-control" 
                           placeholder="PDF/Word Başlığı (örn: MATEMATİK SINAVI)">
                </div>
                <div class="col-md-6">
                    <input id="pdfAltBilgi" 
                           class="form-control" 
                           placeholder="Alt Bilgi (örn: 10. Sınıf | 40 Dakika)">
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-primary" onclick="exportModalAc()">
                    <i class="bi bi-file-earmark-arrow-down-fill"></i> Sınav Kağıdı Hazırla (PDF / Word)
                </button>
                <button class="btn btn-warning" onclick="secilenlerdenYeniBanka()">
                    <i class="bi bi-plus-square-fill"></i> Seçililerden Yeni Banka
                </button>
            </div>
            
            <!-- GLOBAL ZOOM KONTROLÜ -->
            <div class="global-zoom-bar mt-3 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div class="mb-2 mb-md-0">
                        <i class="bi bi-images"></i>
                        <b>Tüm Resimleri Yakınlaştır/Uzaklaştır</b>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn-light" onclick="zoomAll(0.2)" title="Yakınlaştır">
                            <i class="bi bi-zoom-in"></i> Yakınlaştır
                        </button>
                        <button class="btn btn-light" onclick="zoomAll(-0.2)" title="Uzaklaştır">
                            <i class="bi bi-zoom-out"></i> Uzaklaştır
                        </button>
                        <button class="btn btn-outline-light" onclick="resetAllZoom()" title="Sıfırla">
                            <i class="bi bi-arrow-clockwise"></i> Sıfırla
                        </button>
                    </div>
                </div>
            </div>
        </div>

        
        <!-- TOPLU İŞLEMLER ÇUBUĞU -->
        <div id="topluIslemlerBar" class="mb-3 p-2 bg-light border rounded shadow-sm d-none">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="small fw-bold text-muted">
                    <i class="bi bi-check2-square"></i> Seçili Sorularla İşlem Yap:
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary btn-sm" onclick="tumunuSec()">
                        <i class="bi bi-check-all"></i> Tümünü Seç
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="tumunuKaldir()">
                        <i class="bi bi-x"></i> Seçimleri Kaldır
                    </button>
                    <button class="btn btn-danger btn-sm" onclick="secilenleriSil()">
                        <i class="bi bi-trash"></i> Seçilenleri Sil
                    </button>
                      <button class="btn btn-warning btn-sm" onclick="secilenleriSepeteGonder()">
                          <i class="bi bi-cart-plus"></i> Se&ccedil;ilenleri Sepete G&ouml;nder
                      </button>
                </div>
            </div>
        </div>
        
        <!-- SORU LİSTESİ -->
                <!-- GÖRÜNÜM VE DÜZEN AYARLARI -->
        <div class="card shadow-sm mb-3">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <!-- Sütun Görünüm Seçenekleri -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="small fw-bold text-muted"><i class="bi bi-grid-3x3-gap"></i> Görünüm Sütunları:</span>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Görünüm Seçenekleri">
                            <button type="button" class="btn btn-outline-primary" id="gridBtn_12" onclick="setCardLayout('col-12 mb-3', 12)"><i class="bi bi-view-stacked"></i> 1 Sütun (Büyük)</button>
                            <button type="button" class="btn btn-outline-primary active" id="gridBtn_6" onclick="setCardLayout('col-12 col-xl-6 mb-3', 6)"><i class="bi bi-grid-fill"></i> 2 Sütun (Orta)</button>
                            <button type="button" class="btn btn-outline-primary" id="gridBtn_4" onclick="setCardLayout('col-12 col-md-6 col-lg-4 mb-3', 4)"><i class="bi bi-grid-3x3-gap-fill"></i> 3 Sütun (Kompakt)</button>
                            <button type="button" class="btn btn-outline-primary" id="gridBtn_3" onclick="setCardLayout('col-12 col-sm-6 col-md-4 col-lg-3 mb-3', 3)"><i class="bi bi-grid-3x3"></i> 4 Sütun (Mini)</button>
                        </div>
                    </div>
                    
                    <!-- Daralt / Genişlet Seçenekleri -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="small fw-bold text-muted"><i class="bi bi-arrows-angle-contract"></i> Kartları Sığdır:</span>
                        <button class="btn btn-outline-secondary btn-sm" onclick="toggleAllCards(true)">
                            <i class="bi bi-chevron-bar-contract"></i> Tümünü Daralt
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="toggleAllCards(false)">
                            <i class="bi bi-chevron-bar-expand"></i> Tümünü Genişlet
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- SORU FİLTRELEME VE ARAMA ÇUBUĞU -->
        <div class="card shadow-sm mb-3 border-0 bg-white">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5 col-sm-12">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" id="soruFiltreArama" class="form-control border-start-0" placeholder="Metin, etiket veya kaynakta ara..." oninput="window.uygulaSoruFiltre()" />
                            <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('soruFiltreArama').value=''; window.uygulaSoruFiltre();" title="Aramayı Temizle">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <select id="soruFiltreZorluk" class="form-select form-select-sm" onchange="window.uygulaSoruFiltre()">
                            <option value="">🎯 Tüm Zorluklar</option>
                            <option value="cokKolay">🟢 Çok Kolay</option>
                            <option value="kolay">🔵 Kolay</option>
                            <option value="orta">🟡 Orta</option>
                            <option value="zor">🟠 Zor</option>
                            <option value="cokZor">🔴 Çok Zor</option>
                        </select>
                    </div>
                    <div class="col-md-4 col-sm-6 d-flex align-items-center justify-content-end gap-2">
                        <span id="filtreSonucBilgisi" class="badge bg-light text-dark border small py-2 px-2"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.sifirlaSoruFiltre()" title="Filtreleri Sıfırla">
                            <i class="bi bi-arrow-counterclockwise"></i> Sıfırla
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="soruListesi" class="mb-5">
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle fs-1"></i>
                <p class="mt-3">Henüz soru eklenmedi. "Soru Ekle" butonuna tıklayarak başlayın!</p>
            </div>
        </div>
        
    </div>
    





    <!-- ============================================
         SORU EKLE MODAL
         ============================================ -->
    <div class="modal fade" id="soruEkleModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content" style="pointer-events: auto !important; position: relative; z-index: 1056;">
                <div class="modal-header bg-primary text-white d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <h5 class="modal-title mb-0">
                            <i class="bi bi-plus-circle"></i> Soru Detayları
                        </h5>
                        <!-- Navigasyon -->
                        <div id="modalNavigasyon" class="d-none d-flex align-items-center gap-2 border-start ps-3 ms-2">
                            <button type="button" class="btn btn-sm btn-outline-light rounded-pill" onclick="oncekiSoru()" title="Önceki Soru (Sol Ok)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <div class="d-flex align-items-center gap-1">
                                <select id="soruAtlaSelect" class="form-select form-select-sm" style="width: 70px;" onchange="soruAtla(this.value)">
                                    <!-- Dinamik dolacak -->
                                </select>
                                <span id="soruSayaci" class="small text-white-50">1 / 1</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-light rounded-pill" onclick="sonrakiSoru()" title="Sonraki Soru (Sağ Ok)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row">
                        
                        <!-- SOL TARAF - Resim -->
                        <div class="col-xl-5 col-lg-5 mb-3 mb-lg-0 d-flex flex-column">
                            <div class="card h-100 shadow-sm border-0 d-flex flex-column">
                                <div class="card-header bg-white border-bottom-0 py-2 px-3">
                                    <h6 class="mb-0 text-primary fw-bold">
                                        <i class="bi bi-image"></i> Soru Resmi
                                    </h6>
                                </div>
                                <div class="card-body d-flex flex-column p-2 pt-0 flex-grow-1">
                                    <div class="d-flex gap-2 justify-content-center flex-wrap align-items-center mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary shadow-sm py-1 px-2" id="soruResmiSecBtn">
                                            <i class="bi bi-upload"></i> Resim Seç ve Kırp
                                        </button>

                                        <button type="button" class="btn btn-sm btn-outline-success shadow-sm py-1 px-2" id="panodanYapistirBtn" title="Panodaki resmi yapıştır (Kısayol: Ctrl + V)">
                                            <i class="bi bi-clipboard-plus"></i> Panodan Yapıştır <kbd class="bg-light text-success border border-success ms-1 small" style="font-size: 0.7rem; padding: 1px 4px;">Ctrl+V</kbd>
                                        </button>
                                        
                                        <div class="input-group input-group-sm shadow-sm" style="width: auto; border-radius: 6px;">
                                            <span class="input-group-text bg-light border-primary text-primary px-2 py-1" title="Görüntü Kalitesi">
                                                <i class="bi bi-display"></i>
                                            </span>
                                            <select class="form-select form-select-sm border-primary text-primary fw-bold py-1" id="pdfQualitySelectMain" style="min-width: 115px; cursor: pointer;">
                                                <option value="1.0">Düşük Kalite</option>
                                                <option value="1.5">Standart</option>
                                                <option value="2.5" selected>Yüksek (Önerilen)</option>
                                                <option value="4.0">Maksimum</option>
                                            </select>
                                            <button type="button" class="btn btn-sm btn-primary py-1 px-2" id="pdfResmiSecBtn">
                                                <i class="bi bi-file-pdf"></i> PDF'den Seç
                                            </button>
                                        </div>
                                    </div>
                                    <input type="file" id="soruResmiInput" accept="image/*" style="display:none" />
                                    <input type="file" id="pdfResmiInput" accept="application/pdf" style="display:none" />
                                    
                                    <!-- Soru Resmi Önizleme (Büyütülmüş Alan) -->
                                    <div id="soruResmiPreview" class="flex-grow-1 my-1" style="overflow: auto; flex: 1 1 auto; height: 100%; min-height: 480px; max-height: calc(100vh - 210px); border: 2px dashed #cbd5e1; border-radius: 8px; padding: 10px; background: #f8fafc; display: flex; align-items: center; justify-content: center; position: relative;">
                                        <span class="text-muted text-center p-4">
                                            <i class="bi bi-card-image fs-1 opacity-50 d-block mb-1"></i>
                                            <small class="text-secondary">Resim seçin veya panodan yapıştırın (<kbd class="bg-light text-dark border">Ctrl+V</kbd>)</small>
                                        </span>
                                    </div>

                                    <!-- Zoom Butonları (Soru Resminin Altında) -->
                                    <div id="zoomKontrolleriModal" class="d-flex justify-content-center gap-2 pt-2 border-top mt-auto" style="display:none !important;">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="zoomModal(0.1)" title="Yakınlaştır">
                                            <i class="bi bi-zoom-in"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="zoomModal(-0.1)" title="Uzaklaştır">
                                            <i class="bi bi-zoom-out"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetModalZoom()" title="Sıfırla">
                                            <i class="bi bi-aspect-ratio"></i> Sıfırla
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- ORTA TARAF - Soru Metni ve Şıklar -->
                        <div class="col-xl-4 col-lg-4 col-md-6 mb-3 mb-lg-0">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-header bg-white border-bottom-0 py-2 px-3">
                                    <h6 class="mb-0 text-primary fw-bold">
                                        <i class="bi bi-ui-radios-grid"></i> Soru Metni ve Şıklar
                                    </h6>
                                </div>
                                <div class="card-body p-3 pt-2" style="overflow-y: auto; max-height: calc(100vh - 170px);">
                                    
                                    <!-- MATEMATİK & SEMBOL ARAÇ ÇUBUĞU (TOOLBAR) -->
                                    <div class="math-toolbar border rounded p-2 mb-3 bg-light shadow-sm">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small fw-bold text-primary d-flex align-items-center gap-1" style="font-size: 0.82rem;">
                                                <i class="bi bi-calculator"></i> Matematik & Sembol Çubuğu
                                            </span>
                                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none text-secondary" id="toggleMathDrawerBtn" onclick="window.toggleMathDrawer()" style="font-size: 0.78rem;">
                                                <span id="toggleMathDrawerText">Tüm Semboller</span> <i class="bi bi-chevron-down" id="toggleMathDrawerIcon"></i>
                                            </button>
                                        </div>

                                        <!-- Hızlı Erişim Butonları (Her Zaman Görünür) -->
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            <!-- Hızlı Üst İndisler -->
                                            <div class="btn-group btn-group-sm" role="group" title="Üst İndisler">
                                                <button type="button" class="btn btn-outline-primary math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('²')" title="Kare (x²)">x²</button>
                                                <button type="button" class="btn btn-outline-primary math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('³')" title="Küp (x³)">x³</button>
                                                <button type="button" class="btn btn-outline-primary math-btn py-0 px-2" onmousedown="event.preventDefault()" onclick="window.secileniUstIndisYap()" title="Seçileni Üst İndise Çevir (veya ²)"><i class="bi bi-arrow-up-short"></i>xʸ</button>
                                            </div>

                                            <!-- Hızlı Alt İndisler -->
                                            <div class="btn-group btn-group-sm" role="group" title="Alt İndisler">
                                                <button type="button" class="btn btn-outline-secondary math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('₁')" title="Alt 1 (x₁)">x₁</button>
                                                <button type="button" class="btn btn-outline-secondary math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('₂')" title="Alt 2 (x₂)">x₂</button>
                                                <button type="button" class="btn btn-outline-secondary math-btn py-0 px-2" onmousedown="event.preventDefault()" onclick="window.secileniAltIndisYap()" title="Seçileni Alt İndise Çevir (veya ₁)"><i class="bi bi-arrow-down-short"></i>xᵧ</button>
                                            </div>

                                            <!-- Temel Matematik & Fen Sembolleri -->
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn btn-outline-dark math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('√')" title="Karekök (√)">√</button>
                                                <button type="button" class="btn btn-outline-dark math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('π')" title="Pi Sayısı (π)">π</button>
                                                <button type="button" class="btn btn-outline-dark math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('°')" title="Derece (°)">°</button>
                                                <button type="button" class="btn btn-outline-dark math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('±')" title="Artı/Eksi (±)">±</button>
                                                <button type="button" class="btn btn-outline-dark math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('≤')" title="Küçük Eşit (≤)">≤</button>
                                                <button type="button" class="btn btn-outline-dark math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('≥')" title="Büyük Eşit (≥)">≥</button>
                                                <button type="button" class="btn btn-outline-dark math-btn py-0 px-2 fw-bold" onmousedown="event.preventDefault()" onclick="window.sembolEkle('≠')" title="Eşit Değil (≠)">≠</button>
                                            </div>
                                        </div>

                                        <!-- Genişletilebilir Tüm Semboller Bölümü (Drawer) -->
                                        <div id="mathSymbolsDrawer" class="d-none mt-2 pt-2 border-top">
                                            <!-- Sekmeler -->
                                            <ul class="nav nav-pills nav-fill mb-2" id="mathTabs" role="tablist" style="font-size: 0.73rem;">
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link active py-1 px-1" id="tab-ust-tab" data-bs-toggle="pill" data-bs-target="#tab-ust" type="button" role="tab">Üst İndis</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link py-1 px-1" id="tab-alt-tab" data-bs-toggle="pill" data-bs-target="#tab-alt" type="button" role="tab">Alt İndis</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link py-1 px-1" id="tab-islem-tab" data-bs-toggle="pill" data-bs-target="#tab-islem" type="button" role="tab">İşlem/Kesir</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link py-1 px-1" id="tab-yunan-tab" data-bs-toggle="pill" data-bs-target="#tab-yunan" type="button" role="tab">Geometri/Fizik</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link py-1 px-1" id="tab-mantik-tab" data-bs-toggle="pill" data-bs-target="#tab-mantik" type="button" role="tab">Küme/Mantık</button>
                                                </li>
                                            </ul>

                                            <div class="tab-content bg-white p-2 rounded border" id="mathTabsContent" style="max-height: 125px; overflow-y: auto;">
                                                <!-- Üst İndisler -->
                                                <div class="tab-pane fade show active" id="tab-ust" role="tabpanel">
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach(var sym in new[] {"⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹", "⁺", "⁻", "ⁿ", "ˣ", "ʸ", "ᵃ", "ᵇ", "⁽", "⁾"})
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-primary math-grid-btn p-1 px-2" onmousedown="event.preventDefault()" onclick="window.sembolEkle('@sym')">@sym</button>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Alt İndisler -->
                                                <div class="tab-pane fade" id="tab-alt" role="tabpanel">
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach(var sym in new[] {"₀", "₁", "₂", "₃", "₄", "₅", "₆", "₇", "₈", "₉", "₊", "₋", "ₐ", "ₑ", "ₒ", "ₓ", "ₕ", "ₖ", "ₘ", "ₙ", "₍", "₎"})
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-secondary math-grid-btn p-1 px-2" onmousedown="event.preventDefault()" onclick="window.sembolEkle('@sym')">@sym</button>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- İşlem & Kesir -->
                                                <div class="tab-pane fade" id="tab-islem" role="tabpanel">
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach(var sym in new[] {"√", "∛", "∜", "±", "×", "÷", "·", "≤", "≥", "≠", "≈", "≡", "∞", "½", "⅓", "¼", "¾", "⅕", "⅙", "⅛", "‰", "∑", "∏", "∫"})
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-dark math-grid-btn p-1 px-2" onmousedown="event.preventDefault()" onclick="window.sembolEkle('@sym')">@sym</button>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Geometri / Fizik / Yunan -->
                                                <div class="tab-pane fade" id="tab-yunan" role="tabpanel">
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach(var sym in new[] {"°", "π", "α", "β", "γ", "θ", "λ", "μ", "Δ", "Ω", "ρ", "σ", "φ", "ω", "∠", "⊥", "∥", "△", "∼", "≅"})
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-success math-grid-btn p-1 px-2" onmousedown="event.preventDefault()" onclick="window.sembolEkle('@sym')">@sym</button>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Küme & Mantık & Ok -->
                                                <div class="tab-pane fade" id="tab-mantik" role="tabpanel">
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach(var sym in new[] {"∈", "∉", "⊂", "⊃", "⊆", "⊇", "∪", "∩", "∅", "∀", "∃", "∧", "∨", "¬", "→", "↔", "⇒", "⇔"})
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-info math-grid-btn p-1 px-2" onmousedown="event.preventDefault()" onclick="window.sembolEkle('@sym')">@sym</button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-2 text-muted" style="font-size: 0.72rem;">
                                                <i class="bi bi-lightbulb text-warning me-1"></i>
                                                <strong>Akıllı Kısayollar:</strong> Yazarken <code>^2</code> yazarsanız <code>²</code>, <code>_1</code> yazarsanız <code>₁</code>, <code>+-</code> yazarsanız <code>±</code>, <code>&lt;=</code> yazarsanız <code>≤</code>, <code>&gt;=</code> yazarsanız <code>≥</code> otomatik oluşur.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Soru Metni (Şıkların Üzerinde) -->
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2 bg-light p-2 rounded">
                                            <label class="form-label fw-bold mb-0 text-primary small">
                                                <i class="bi bi-card-text me-1"></i> Soru Metni
                                            </label>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="soruMetniAyriMi">
                                                <label class="form-check-label text-muted small" for="soruMetniAyriMi">
                                                    Metin ayrı mı?
                                                </label>
                                            </div>
                                        </div>
                                        <textarea class="form-control" id="soruMetniInput" rows="4" 
                                                  placeholder="Soru metnini buraya yazın..."></textarea>
                                        <div class="form-text small mt-1">
                                            <i class="bi bi-info-circle text-primary"></i> 
                                            Soru metni resim içindeyse anahtarı kapatıp boş bırakın.
                                        </div>
                                    </div>

                                    <!-- Şıklar ve Doğru Cevap -->
                                    <div class="border-top pt-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2 bg-light p-2 rounded">
                                            <label class="form-label mb-0 fw-bold small text-primary">
                                                <i class="bi bi-ui-radios me-1"></i> Şıklar Ayrı mı?
                                            </label>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="sikkarAyriMi">
                                            </div>
                                        </div>
                                        
                                        <p class="text-muted small mb-2 d-flex justify-content-between align-items-center flex-wrap gap-1">
                                            <span><i class="bi bi-check2-circle text-success"></i> Doğru cevabı işaretleyin:</span>
                                            <span class="badge bg-light text-dark border"><kbd class="bg-white text-dark border">Alt</kbd> + <kbd class="bg-white text-dark border">A</kbd>/<kbd class="bg-white text-dark border">B</kbd>/<kbd class="bg-white text-dark border">C</kbd>/<kbd class="bg-white text-dark border">D</kbd>/<kbd class="bg-white text-dark border">E</kbd></span>
                                        </p>
                                        
                                        <div id="siklar-container" class="d-flex flex-column gap-2">
                                            @foreach(var harf in new[] {"A", "B", "C", "D", "E"})
                                            {
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text bg-white p-0">
                                                        <input type="radio" 
                                                               name="dogruSik" 
                                                               id="dogruSik_@harf" 
                                                               value="@harf" 
                                                               @(harf == "A" ? "checked" : "")
                                                               class="btn-check">
                                                        <label class="btn btn-outline-success border-0 px-3 py-1 m-0 fw-bold" for="dogruSik_@harf" title="Doğru Cevap @harf (Kısayol: Alt + @harf)">@harf</label>
                                                    </span>
                                                    <input type="text" 
                                                           class="form-control sikk-input border-start-0 bg-light" 
                                                           id="@harf" 
                                                           placeholder="@harf şıkkı (İsteğe bağlı)">
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>

                        <!-- SAĞ TARAF - Kategori (Ders, Konu, Kazanım) -->
                        <div class="col-xl-3 col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-header bg-white border-bottom-0 py-2 px-3">
                                    <h6 class="mb-0 text-primary fw-bold">
                                        <i class="bi bi-tags"></i> Kategori Bilgileri
                                    </h6>
                                </div>
                                <div class="card-body p-3 pt-2" style="overflow-y: auto; max-height: calc(100vh - 170px);">
                                    
                                    <div class="bg-light p-3 rounded mb-3">
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold text-muted mb-1 d-flex align-items-center">
                                                <i class="bi bi-book text-primary me-1"></i> Ders
                                            </label>
                                            <select class="form-select form-select-sm" id="dersSelect">
                                                <option value="">Ders Seçin (Opsiyonel)</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold text-muted mb-1 d-flex align-items-center">
                                                <i class="bi bi-bookmark text-info me-1"></i> Konu
                                            </label>
                                            <select class="form-select form-select-sm" id="konuSelect">
                                                <option value="">Önce ders seçin</option>
                                            </select>
                                        </div>
                                        <div class="mb-1">
                                            <label class="form-label small fw-bold text-muted mb-1 d-flex align-items-center">
                                                <i class="bi bi-check2-square text-success me-1"></i> Kazanım
                                            </label>
                                            <select class="form-select form-select-sm" id="kazanimSelect">
                                                <option value="">Önce konu seçin</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="alert alert-light border small text-muted p-2 mb-3">
                                        <i class="bi bi-info-circle text-info me-1"></i> 
                                        Ders, konu ve kazanım seçimi opsiyoneldir. Soru bankasını gruplamak ve filtrelemek için kullanılır.
                                    </div>

                                    <!-- SORU ÖZELLİKLERİ & EK BİLGİLER -->
                                    <div class="border rounded p-3 bg-light">
                                        <h6 class="text-primary fw-bold small mb-2 d-flex align-items-center">
                                            <i class="bi bi-sliders me-1"></i> Soru Özellikleri & Notlar
                                        </h6>

                                        <!-- Zorluk Seviyesi -->
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold text-muted mb-1 d-flex align-items-center">
                                                <i class="bi bi-speedometer2 text-warning me-1"></i> Zorluk Seviyesi
                                            </label>
                                            <select class="form-select form-select-sm" id="zorlukSelect">
                                                <option value="cokKolay">🟢 Çok Kolay</option>
                                                <option value="kolay">🔵 Kolay</option>
                                                <option value="orta" selected>🟡 Orta (Standart)</option>
                                                <option value="zor">🟠 Zor</option>
                                                <option value="cokZor">🔴 Çok Zor</option>
                                            </select>
                                        </div>

                                        <!-- Kaynak -->
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold text-muted mb-1 d-flex align-items-center">
                                                <i class="bi bi-journal-bookmark text-primary me-1"></i> Kaynak
                                            </label>
                                            <input type="text" class="form-control form-control-sm" id="kaynakInput" placeholder="Örn: 2024 LGS, MEB, Özgün..." />
                                        </div>

                                        <!-- Etiketler -->
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold text-muted mb-1 d-flex align-items-center">
                                                <i class="bi bi-tags text-success me-1"></i> Etiketler
                                            </label>
                                            <input type="text" class="form-control form-control-sm" id="etiketInput" placeholder="Örn: sevdiğim sorular, yeni nesil..." />
                                            <small class="text-muted" style="font-size:0.75rem;">Virgülle ayırarak birden fazla etiket girebilirsiniz.</small>
                                        </div>

                                        <!-- Çözüm Linki -->
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold text-muted mb-1 d-flex align-items-center">
                                                <i class="bi bi-link-45deg text-danger me-1"></i> Çözüm Linki / Videosu
                                            </label>
                                            <div class="input-group input-group-sm">
                                                <input type="url" class="form-control" id="cozumLinkiInput" placeholder="https://youtube.com/..." />
                                                <button type="button" class="btn btn-outline-secondary" onclick="window.testCozumLinki()" title="Linki Aç">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Açıklama / Ek Not -->
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold text-muted mb-1 d-flex align-items-center">
                                                <i class="bi bi-sticky text-info me-1"></i> Açıklama / Not
                                            </label>
                                            <textarea class="form-control form-control-sm" id="aciklamaInput" rows="2" placeholder="Ek açıklama, çözüm ipucu vb..."></textarea>
                                        </div>

                                        <!-- Tarih Bilgisi (Düzenleme modunda görünür) -->
                                        <div id="soruTarihBilgisi" class="alert alert-light border small text-muted p-2 mb-0 mt-2" style="display:none;"></div>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    
                    <script>
                    // Şıklar ayrı mı anahtarını dinle
                    document.getElementById('sikkarAyriMi')?.addEventListener('change', function() {
                        const inputs = document.querySelectorAll('.sikk-input');
                        inputs.forEach(input => {
                            input.disabled = !this.checked;
                            if (!this.checked) {
                                input.placeholder = 'Şıklar resim içinde';
                            } else {
                                const harf = input.id;
                                input.placeholder = `${harf} şıkkı`;
                            }
                        });
                    });
                    
                    // Soru metni ayrı mı anahtarını dinle
                    document.getElementById('soruMetniAyriMi')?.addEventListener('change', function() {
                        const textarea = document.getElementById('soruMetniInput');
                        textarea.disabled = !this.checked;
                        if (!this.checked) {
                            textarea.placeholder = 'Soru metni resim içinde';
                        } else {
                            textarea.placeholder = 'Soru metnini buraya yazın...';
                        }
                    });
                    </script>
                </div>
                <div class="modal-footer" style="pointer-events: auto !important; position: relative; z-index: 1057;">
                    <button type="button" class="btn btn-success" id="soruKaydetBtn" onclick="window.soruKaydet(event)" title="Kaydet (Kısayol: Ctrl + K)" style="pointer-events: auto !important; position: relative; z-index: 1058;"> 
                        <i class="bi bi-check-circle"></i> Kaydet <kbd class="bg-white text-success border ms-1 small" style="font-size: 0.72rem; padding: 2px 5px;">Ctrl+K</kbd>
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="console.log('[HTML CLICK] İptal butonuna tıklandı!')" style="pointer-events: auto !important; position: relative; z-index: 1058;">
                        <i class="bi bi-x-circle"></i> İptal
                    </button>
                </div>
            </div>
        </div>
    </div>
    
