                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" id="pdfZoomOutBtn" title="Uzaklaştır">
                            <i class="bi bi-zoom-out"></i>
                        </button>
                        <span id="pdfZoomInfo" class="small fw-bold text-muted" style="min-width: 40px;">150%</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" id="pdfZoomInBtn" title="Yakınlaştır">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- Seri Soru Ekleme için Doğru Cevap Seçimi (Radyo Butonlar) -->
                        <div class="d-flex align-items-center gap-2 me-2" id="pdfDogruCevapContainer" style="display:none;">
                            <span class="small fw-bold">Cevap:</span>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Doğru Cevap">
                                <input type="radio" class="btn-check" name="pdfDogruSik" id="pdfDogruA" value="A" checked>
                                <label class="btn btn-sm btn-outline-success px-2 py-1" for="pdfDogruA">A</label>

                                <input type="radio" class="btn-check" name="pdfDogruSik" id="pdfDogruB" value="B">
                                <label class="btn btn-sm btn-outline-success px-2 py-1" for="pdfDogruB">B</label>

                                <input type="radio" class="btn-check" name="pdfDogruSik" id="pdfDogruC" value="C">
                                <label class="btn btn-sm btn-outline-success px-2 py-1" for="pdfDogruC">C</label>

                                <input type="radio" class="btn-check" name="pdfDogruSik" id="pdfDogruD" value="D">
                                <label class="btn btn-sm btn-outline-success px-2 py-1" for="pdfDogruD">D</label>

                                <input type="radio" class="btn-check" name="pdfDogruSik" id="pdfDogruE" value="E">
                                <label class="btn btn-sm btn-outline-success px-2 py-1" for="pdfDogruE">E</label>
                            </div>
                        </div>
                        
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle"></i> Kapat
                        </button>
                        
                        <!-- Tekli Mod Butonu -->
                        <button type="button" class="btn btn-sm btn-success" id="pdfOnaylaBtn">
                            <i class="bi bi-crop"></i> Seçilen Alanı Kırp
                        </button>
                        
                        <!-- Seri Mod Butonu -->
                        <button type="button" class="btn btn-sm btn-warning" id="pdfSeriEkleBtn" style="display:none;">
                            <i class="bi bi-plus-circle"></i> Soru Ekle
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Ders/Konu/Kazanım Yönetimi Modal -->
    <div class="modal fade" id="dersEkleModal" tabindex="-1" aria-labelledby="dersEkleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <div>
                        <h5 class="modal-title" id="dersEkleModalLabel">
                            <i class="bi bi-folder-plus"></i> Ders/Konu/Kazanım Yönetimi
                        </h5>
                        <small class="d-block mt-1">Eğitim müfredatınızı düzenleyin</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <!-- DERSLER Sütunu -->
                        <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-primary text-white">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0"><i class="bi bi-book"></i> Dersler</h6>
                                        <span class="badge bg-light text-dark" id="dersCount">0</span>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <ul id="dersListesi" class="list-group list-group-flush" style="min-height:200px; max-height:300px; overflow-y:auto;"></ul>
                                </div>
                                <div class="card-footer">
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="text" id="dersAdiInput" class="form-control" placeholder="Ders adı">
                                        <button class="btn btn-success" id="dersEkleOnayBtn"><i class="bi bi-plus-lg"></i></button>
                                    </div>
                                    <button class="btn btn-danger btn-sm w-100" id="dersSilBtn"><i class="bi bi-trash"></i> Seçili Dersi Sil</button>
                                </div>
                            </div>
                        </div>
                        <!-- KONULAR Sütunu -->
                        <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-info text-white">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0"><i class="bi bi-bookmark"></i> Konular</h6>
                                        <span class="badge bg-light text-dark" id="konuCount">0</span>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <ul id="konuListesi" class="list-group list-group-flush" style="min-height:200px; max-height:300px; overflow-y:auto;"></ul>
                                </div>
                                <div class="card-footer">
                                    <div class="input-group input-group-sm mb-2">
                    
                                    <button class="btn btn-danger btn-sm w-100" id="konuSilBtn"><i class="bi bi-trash"></i> Seçili Konuyu Sil</button>
                                </div>
                            </div>
                        </div>
                        <!-- KAZANIMLAR Sütunu -->
                        <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-success text-white">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0"><i class="bi bi-trophy"></i> Kazanımlar</h6>
                                        <span class="badge bg-light text-dark" id="kazanimCount">0</span>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <ul id="kazanimListesi" class="list-group list-group-flush" style="min-height:200px; max-height:300px; overflow-y:auto;"></ul>
                                </div>
                                <div class="card-footer">
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="text" id="kazanimAdiInput" class="form-control" placeholder="Kazanım adı">
                                        <button class="btn btn-success" id="kazanimEkleOnayBtn"><i class="bi bi-plus-lg"></i></button>
                                    </div>
                                    <button class="btn btn-danger btn-sm w-100" id="kazanimSilBtn"><i class="bi bi-trash"></i> Seçili Kazanımı Sil</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- EXPORT SETTINGS MODAL -->
    <div class="modal fade" id="exportSettingsModal" tabindex="-1" aria-labelledby="exportSettingsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h5 class="modal-title" id="exportSettingsModalLabel">
                        <i class="bi bi-file-earmark-pdf-fill"></i> Sınav / Yaprak Test Hazırla
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="exportForm">
                        <!-- Format Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-filetype-pdf"></i> Çıktı Formatı</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="exportFormat" id="formatPdf" value="pdf" checked>
                                    <label class="form-check-label" for="formatPdf">PDF (Önizleme & Yazdır)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="exportFormat" id="formatWord" value="word">
                                    <label class="form-check-label" for="formatWord">Word Belgesi (.docx)</label>
                                </div>
                            </div>
                        </div>

                        <!-- Question Source -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-question-circle"></i> Soru Kaynağı</label>
                            <select class="form-select" id="exportSource">
                                <option value="tum">Tüm Sorular (Listelenen her şey)</option>
                                <option value="secili">Sadece Seçilen Sorular</option>
                            </select>
                        </div>

                        <!-- Column Count -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-columns-gap"></i> Sütun Sayısı</label>
                            <select class="form-select" id="exportColumns">
                                <option value="1">1 Sütunlu (Alt alta)</option>
                                <option value="2" selected>2 Sütunlu (Yaprak Test)</option>
                                <option value="3">3 Sütunlu (Ekonomik/Yoğun)</option>
                            </select>
                        </div>

                        <!-- Booklet Count -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-journal-album"></i> Kitapçık Türü (Sayısı)</label>
                            <select class="form-select" id="exportGroupCount">
                                <option value="1" selected>1 (Sadece A Kitapçığı)</option>
                                <option value="2">2 (A, B Kitapçıkları)</option>
                                <option value="3">3 (A, B, C Kitapçıkları)</option>
                                <option value="4">4 (A, B, C, D Kitapçıkları)</option>
                            </select>
                        </div>
                        
                        <!-- Optimization Checkbox (Visible only when Booklet Count == 1) -->
                        <div class="form-check form-switch mb-3" id="exportOptimizationContainer">
                            <input class="form-check-input" type="checkbox" role="switch" id="exportOptimization">
                            <label class="form-check-label fw-bold" for="exportOptimization">Boyut Optimizasyonu Olsun mu? (Boşlukları en aza indirir)</label>
                        </div>

                        <!-- Header and Footer -->
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="exportHeader"><i class="bi bi-input-cursor-text"></i> Üst Bilgi (Başlık)</label>
                            <input type="text" class="form-control" id="exportHeader" placeholder="Örn: 1. Dönem 1. Matematik Sınavı">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="exportFooter"><i class="bi bi-info-circle"></i> Alt Bilgi (Footer)</label>
                            <input type="text" class="form-control" id="exportFooter" placeholder="Örn: Başarılar Dileriz. Süre: 40dk">
                        </div>

                        <!-- Alignment Selection -->
                        <div class="mb-3" id="pdfAlignmentContainer">
                            <label class="form-label fw-bold"><i class="bi bi-align-start"></i> Soru Hizalaması (Yalnızca PDF)</label>
                            <select class="form-select" id="exportAlignment">
                                <option value="left" selected>Sola Yasla (Sol Sütun hizalı)</option>
                                <option value="center">Ortala (Soru metnini ve resmi ortala)</option>
                                <option value="justify">İki Yana Yasla (Dengeli)</option>
                            </select>
                        </div>

                        <!-- Image Width Selection -->
                        <div class="mb-3" id="pdfImageWidthContainer">
                            <label class="form-label fw-bold"><i class="bi bi-image"></i> Soru Resimlerinin Boyutu (Yalnızca PDF)</label>
                            <select class="form-select" id="exportImageWidth">
                                <option value="optimize" selected>Optimize Genişlik (Önerilen - Otomatik Sığdır)</option>
                                <option value="fit">Sütuna Sığdır (Sütun genişliğini %100 kaplasın)</option>
                                <option value="original">Orijinal Resim Genişliği (Maksimum boyutta)</option>
                            </select>
                        </div>

                        <!-- Answer Key Toggle -->
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="exportAnswerKey" checked>
                            <label class="form-check-label fw-bold" for="exportAnswerKey">Cevap Anahtarı Ekle</label>
                        </div>
                        
                        <!-- Layout Toggles -->
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="exportOgrenciBilgi" checked>
                            <label class="form-check-label fw-bold" for="exportOgrenciBilgi">Öğrenci Bilgi Alanı Ekle</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="exportSayfaNo" checked>
                            <label class="form-check-label fw-bold" for="exportSayfaNo">Sayfa Numaralarını Göster</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="exportUstAltBilgi" checked>
                            <label class="form-check-label fw-bold" for="exportUstAltBilgi">Üst/Alt Bilgi (Başlık/Footer) Göster</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" id="btnExportConfirm" onclick="exportYap()" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border:none;">
                        <i class="bi bi-file-earmark-arrow-down"></i> Belgeyi Oluştur
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- ============================================
         JAVASCRIPT KÜTÜPHANELERİ
         ============================================ -->
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Sortable.js (Drag & Drop) -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    
    <!-- Cropper.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    
    <!-- PDF.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    </script>
    
    <!-- html2pdf.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    
    <!-- html-docx.js -->
    <script src="https://unpkg.com/html-docx-js/dist/html-docx.js"></script>
    
    <!-- html2pdf.js for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    
    <!-- FileSaver.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    
    <!-- Mammoth.js (Word template to HTML) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
    
    <!-- ÖZEL JAVASCRIPT DOSYALARI -->
    
    <script src="~/js/ders-yonetimi.js" asp-append-version="true"></script>
    <script src="~/js/export-handler.js" asp-append-version="true"></script>
    <script src="~/lib/sqljs/sql-wasm.js" asp-append-version="true"></script>
    <!-- SHIELD_ENCRYPTION_START: Add password variable and Encryption service -->
    <script>
        window.USER_DB_PASSWORD = "@ViewData["Sifre"]";
        window.USER_ROLE = "@Context.Session.GetString("KullaniciTuru")";
    </script>
    <script src="~/js/aes-encryption.js?v=2" asp-append-version="true"></script>
    <!-- SHIELD_ENCRYPTION_END -->
    <script src="~/js/soru-bankasi.js?v=2" asp-append-version="true"></script>
    <script src="~/js/client-db-service.js?v=2" asp-append-version="true"></script>
    
</body>
</html>
