                        <select class="form-select form-select-sm" id="pdfKonuSelect" style="min-width: 150px; width: auto;">
                            <option value="">Önce ders seçin</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="small fw-bold">Kazanım:</span>
                        <select class="form-select form-select-sm" id="pdfKazanimSelect" style="min-width: 180px; width: auto;">
                            <option value="">Önce konu seçin</option>
                        </select>
                    </div>
                </div>

                <div class="modal-body text-center d-flex flex-column align-items-center" style="max-height: 65vh; overflow: hidden; background-color: #e9ecef; padding: 10px;">
                    <div id="pdfCropperContainer" style="box-shadow: 0 4px 15px rgba(0,0,0,0.15); background: white; padding: 10px; border-radius: 4px; width: 100%; height: 100%; max-height: 60vh; overflow: auto; position: relative;">
                        <div id="pdfCropperWrapper" style="position: relative; width: 100%; height: auto; margin: 0 auto;">
                            <img id="pdfCropperImage" style="display: block; width: 100%; height: 100%;">
