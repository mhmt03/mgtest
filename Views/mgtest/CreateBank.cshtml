                                <option value="4.0">Maksimum (Yavaş)</option>
                            </select>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                </div>
                
                <!-- Seri Soru Ekleme için Ders/Konu/Kazanım Seçimi -->
                <div class="bg-light p-2 border-bottom d-flex align-items-center gap-2 justify-content-center flex-wrap" id="pdfKategoriBar" style="display:none !important;">
