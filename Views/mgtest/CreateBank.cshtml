                        <i class="bi bi-check-circle"></i> Onayla
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- ============================================
         PDF SEÇİM MODALİ
         ============================================ -->
    <div class="modal fade" id="pdfSecModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
        <div class="modal-dialog modal-xl" style="z-index: 1061;">
            <div class="modal-content" style="pointer-events: auto !important; position: relative; z-index: 1056;">
                <div class="modal-header bg-primary text-white d-flex align-items-center justify-content-between">
                    <h5 class="modal-title mb-0">
                        <i class="bi bi-file-pdf"></i> PDF'den Sayfa Seç ve Kırp
                    </h5>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center gap-1 bg-white rounded p-1 shadow-sm">
