@{
    ViewData["Title"] = "Sepetim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Geri Dön ve Ana Sayfa Butonları -->
    <div class="d-flex gap-2 mb-3">
        <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Geri Dön
        </a>
        <a href="/mgtest/Index" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-house"></i> Ana Sayfa
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-cart3 text-primary"></i> Seçili Sorular 
            <span class="badge bg-secondary rounded-pill fs-6 align-middle" id="sepetSoruSayac">0</span>
        </h2>
        <button class="btn btn-outline-danger shadow-sm" id="sepetTemizleBtn">
            <i class="bi bi-trash"></i> Sepeti Temizle
        </button>
    </div>

    <!-- Soru Listesi -->
    <div id="sepetSoruListesi" class="mb-5 pb-5">
        <!-- Sorular sepet.js tarafından buraya yüklenecek -->
    </div>
</div>

<!-- Alt Bar (Sepet doluysa görünür) -->
<div id="kartAltBar" class="d-none" style="position: fixed; bottom: 0; left: 0; right: 0; background: white; z-index: 1040; box-shadow: 0 -5px 20px rgba(0,0,0,0.1);">
    <div class="container-fluid py-3">
        <div class="row align-items-center">
            <div class="col-xl-6 col-lg-7 col-md-12 mb-2 mb-md-0 d-flex flex-wrap gap-2 align-items-center">
                <div class="input-group" style="flex: 1; min-width: 250px;">
                    <span class="input-group-text"><i class="bi bi-file-earmark-text"></i> Soru Bankası Adı</span>
                    <input type="text" class="form-control form-control-sm" id="sepetBankaAdi" placeholder="Banka Adı (.mg için)">
                </div>
            </div>
            <div class="col-xl-6 col-lg-5 col-md-12 text-md-end text-center d-flex gap-2 justify-content-md-end justify-content-center mt-2 mt-lg-0 flex-wrap">
                <button class="btn btn-primary btn-lg shadow-sm" onclick="exportModalAc()">
                    <i class="bi bi-file-earmark-arrow-down-fill"></i> Sınav Kağıdı Hazırla (PDF / Word)
                </button>
                <button class="btn btn-dark btn-lg shadow-sm" id="bankayiKaydetBtn" title="Soruları SQLite bankası (.mg) olarak kaydet">
                    <i class="bi bi-save"></i> Bankayı Kaydet (.mg)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- EXPORT SETTINGS MODAL -->
<div class="modal fade" id="exportSettingsModal" tabindex="-1" aria-labelledby="exportSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <h5 class="modal-title" id="exportSettingsModalLabel">
                    <i class="bi bi-file-earmark-pdf-fill"></i> Sınav / Yaprak Test Hazırla
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="exportForm">
                    <!-- Format Selection -->
                    <div class="mb-3">
                        <label class="form-label fw-bold"><i class="bi bi-filetype-pdf"></i> Çıktı Formatı</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="exportFormat" id="formatPdf" value="pdf" checked>
                                <label class="form-check-label" for="formatPdf">PDF (Önizleme & Yazdır)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="exportFormat" id="formatWord" value="word">
                                <label class="form-check-label" for="formatWord">Word Belgesi (.docx)</label>
                            </div>
                        </div>
                    </div>

                    <!-- Question Source -->
                    <div class="mb-3">
                        <label class="form-label fw-bold"><i class="bi bi-question-circle"></i> Soru Kaynağı</label>
                        <select class="form-select" id="exportSource">
                            <option value="tum" selected>Tüm Sorular (Sepetteki her şey)</option>
                            <option value="secili">Sadece Seçilen Sorular</option>
                        </select>
                    </div>

                    <!-- Column Count -->
                    <div class="mb-3">
                        <label class="form-label fw-bold"><i class="bi bi-columns-gap"></i> Sütun Sayısı</label>
                        <select class="form-select" id="exportColumns">
                            <option value="1">1 Sütunlu (Alt alta)</option>
                            <option value="2" selected>2 Sütunlu (Yaprak Test)</option>
                            <option value="3">3 Sütunlu (Ekonomik/Yoğun)</option>
                        </select>
                    </div>

                    <!-- Header and Footer -->
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="exportHeader"><i class="bi bi-input-cursor-text"></i> Üst Bilgi (Başlık)</label>
                        <input type="text" class="form-control" id="exportHeader" placeholder="Örn: 1. Dönem 1. Matematik Sınavı">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="exportFooter"><i class="bi bi-info-circle"></i> Alt Bilgi (Footer)</label>
                        <input type="text" class="form-control" id="exportFooter" placeholder="Örn: Başarılar Dileriz. Süre: 40dk">
                    </div>

                    <!-- Alignment Selection -->
                    <div class="mb-3" id="pdfAlignmentContainer">
                        <label class="form-label fw-bold"><i class="bi bi-align-start"></i> Soru Hizalaması (Yalnızca PDF)</label>
                        <select class="form-select" id="exportAlignment">
                            <option value="left" selected>Sola Yasla (Sol Sütun hizalı)</option>
                            <option value="center">Ortala (Soru metnini ve resmi ortala)</option>
                            <option value="justify">İki Yana Yasla (Dengeli)</option>
                        </select>
                    </div>

                    <!-- Image Width Selection -->
                    <div class="mb-3" id="pdfImageWidthContainer">
                        <label class="form-label fw-bold"><i class="bi bi-image"></i> Soru Resimlerinin Boyutu (Yalnızca PDF)</label>
                        <select class="form-select" id="exportImageWidth">
                            <option value="optimize" selected>Optimize Genişlik (Önerilen - Otomatik Sığdır)</option>
                            <option value="fit">Sütuna Sığdır (Sütun genişliğini %100 kaplasın)</option>
                            <option value="original">Orijinal Resim Genişliği (Maksimum boyutta)</option>
                        </select>
                    </div>

                    <!-- Answer Key Toggle -->
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="exportAnswerKey" checked>
                        <label class="form-check-label fw-bold" for="exportAnswerKey">Cevap Anahtarı Ekle</label>
                    </div>

                    <!-- Detailed Answer Key Toggle -->
                    <div class="form-check form-switch mb-3" id="exportDetailKeyContainer">
                        <input class="form-check-input" type="checkbox" role="switch" id="exportDetailKey">
                        <label class="form-check-label fw-bold" for="exportDetailKey">Ders, Konu, Kazanım Eklesin mi?</label>
                    </div>

                    <!-- Group Toggle -->
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="exportCreateGroups">
                        <label class="form-check-label fw-bold" for="exportCreateGroups">Grup Yapılsın mı?</label>
                    </div>

                    <!-- Group Count Dropdown (Hidden by default) -->
                    <div class="mb-3 d-none" id="exportGroupCountContainer">
                        <label class="form-label fw-bold"><i class="bi bi-people"></i> Grup Sayısı</label>
                        <select class="form-select" id="exportGroupCount">
                            <option value="2" selected>2 Grup (A, B)</option>
                            <option value="3">3 Grup (A, B, C)</option>
                            <option value="4">4 Grup (A, B, C, D)</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-top-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" id="btnExportConfirm" onclick="exportYap()" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border:none;">
                    <i class="bi bi-file-earmark-arrow-down"></i> Belgeyi Oluştur
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SortableJS (Sürükle bırak için) -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="~/js/export-handler.js" asp-append-version="true"></script>
    <script src="~/js/sepet.js" asp-append-version="true"></script>
}
