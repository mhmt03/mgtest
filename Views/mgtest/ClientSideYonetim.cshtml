@{
    ViewData["Title"] = "Client-Side Soru Bankası Yönetimi";
    Layout = "_Layout";
    var sifre = ViewData["Sifre"] as string;
}

<div class="container mt-5">
    <h2>Client-Side SQLite Yönetimi (Şifreli)</h2>
    <p class="text-muted">Bu sayfada, şifreli `.mg` veritabanı dosyanız tarayıcıda AES-GCM ile çözülüp sql.js ile işlenir ve her değişiklik doğrudan dosyanıza kaydedilir.</p>

    <!-- Hata ve Bilgi Mesajları -->
    <div id="alertBox" class="alert d-none"></div>

    <!-- Başlangıç Görünümü: Dosya Seçimi -->
    <div id="stepFileSelection" class="card shadow-sm mb-4">
        <div class="card-body text-center py-5">
            <h4 class="mb-3">Çalışmak İçin Bir Soru Bankası Seçin</h4>
            <p>Bilgisayarınızdaki <code>.mg</code> uzantılı şifreli Soru Bankası dosyanızı seçin.</p>
            <button id="btnSelectDatabase" class="btn btn-primary btn-lg mt-2">
                <i class="fas fa-folder-open me-2"></i> Mevcut Veritabanını Aç
            </button>
            @if (Context.Session.GetString("KullaniciTuru") == "admin")
            {
                <button id="btnSelectDatabaseAdmin" class="btn btn-danger btn-lg mt-2 ms-2">
                    <i class="fas fa-user-shield me-2"></i> Başkasının Bankasını Aç
                </button>
            }
            <div id="loadingIndicator" class="mt-3 d-none">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-primary" id="loadingText">Veritabanı hazırlanıyor...</p>
            </div>
            
            <hr class="my-4">
            
            <!-- Yeni Banka Oluşturma -->
            <div class="mt-4 p-4 bg-light rounded text-start">
                <h5 class="text-success"><i class="fas fa-plus-circle me-2"></i> Sıfırdan Yeni Soru Bankası Oluştur</h5>
                <p class="small text-muted">Henüz bir Soru Bankası dosyanız yoksa, buradan anında yeni bir tane oluşturup bilgisayarınıza şifresiz düz SQLite formatında kaydedebilirsiniz.</p>
                <div class="input-group">
                    <input type="text" id="newBankName" class="form-control" placeholder="Örn: 2026_Matematik_Bankasi">
                    <button id="btnCreateNewBank" class="btn btn-success px-4">Oluştur ve Kaydet</button>
                </div>
            </div>

            <!-- Eski Dosya Dönüştürücü (Geliştirme süresince gizlenebilir ama dursun) -->
            <hr class="my-4">
            <h5 class="text-secondary text-start">Eski (SQLCipher) Dosyalarınızı Dönüştürün</h5>
            <p class="small text-muted text-start">Eğer eski sistemde oluşturulmuş bir .mg dosyanız varsa, şifrelemesini kaldırıp düz SQLite dosyası yapmak için buradan dönüştürebilirsiniz.</p>
            <div class="text-start">
                <input type="file" id="fileLegacyDb" class="d-none" accept=".mg,.db">
                <button id="btnConvertLegacy" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('fileLegacyDb').click()">
                    <i class="fas fa-exchange-alt me-1"></i> Eski Dosyanın Şifresini Kaldır (Dönüştür)
                </button>
            </div>
        </div>
    </div>

    <!-- İşlem Görünümü: Veritabanı Açıldıktan Sonra -->
    <div id="stepDatabaseOperations" class="d-none">
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="text-success mb-0"><i class="fas fa-database me-2"></i> Aktif Veritabanı</h5>
                    <small id="activeFileName" class="text-muted"></small>
                </div>
                <button id="btnCloseDatabase" class="btn btn-outline-danger btn-sm">
                    Kapat
                </button>
            </div>
        </div>

        <div class="row g-4">
            <!-- Dersler Listesi -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">Dersler</div>
                    <ul class="list-group list-group-flush" id="dersListesi" style="height: 300px; overflow-y: auto;">
                        <li class="list-group-item text-muted">Yükleniyor...</li>
                    </ul>
                    <div class="card-footer">
                        <div class="input-group input-group-sm mb-2">
                            <input type="text" id="yeniDersAd" class="form-control" placeholder="Yeni ders adı">
                            <button class="btn btn-success" id="btnDersEkle"><i class="fas fa-plus"></i></button>
                        </div>
                        <button class="btn btn-danger btn-sm w-100" id="btnDersSil">Seçili Dersi Sil</button>
                    </div>
                </div>
            </div>

            <!-- Konular Listesi -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-info text-white">Konular</div>
                    <ul class="list-group list-group-flush" id="konuListesi" style="height: 300px; overflow-y: auto;">
                        <li class="list-group-item text-muted">Önce ders seçin</li>
                    </ul>
                    <div class="card-footer">
                        <div class="input-group input-group-sm mb-2">
                            <input type="text" id="yeniKonuAd" class="form-control" placeholder="Yeni konu adı">
                            <button class="btn btn-success" id="btnKonuEkle"><i class="fas fa-plus"></i></button>
                        </div>
                        <button class="btn btn-danger btn-sm w-100" id="btnKonuSil">Seçili Konuyu Sil</button>
                    </div>
                </div>
            </div>

            <!-- Kazanımlar Listesi -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-success text-white">Kazanımlar</div>
                    <ul class="list-group list-group-flush" id="kazanimListesi" style="height: 300px; overflow-y: auto;">
                        <li class="list-group-item text-muted">Önce konu seçin</li>
                    </ul>
                    <div class="card-footer">
                        <div class="input-group input-group-sm mb-2">
                            <input type="text" id="yeniKazanimAd" class="form-control" placeholder="Yeni kazanım adı">
                            <button class="btn btn-success" id="btnKazanimEkle"><i class="fas fa-plus"></i></button>
                        </div>
                        <button class="btn btn-danger btn-sm w-100" id="btnKazanimSil">Seçili Kazanımı Sil</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Şifre bilgisini güvenli bir şekilde JavaScript'e aktarma -->
<script>
    window.USER_DB_PASSWORD = "@ViewData["Sifre"]";
    window.USER_ROLE = "@Context.Session.GetString("KullaniciTuru")";
</script>

@section Scripts {
    <!-- 1. sql.js wasm -->
    <script src="~/lib/sqljs/sql-wasm.js"></script>
    <!-- 2. AES Encryption Service -->
    <script src="~/js/aes-encryption.js"></script>
    <!-- 3. İstemci Veritabanı Yöneticisi -->
    <script src="~/js/client-db-service.js"></script>
}
