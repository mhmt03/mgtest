@{
    ViewData["Title"] = "Soruları Taşı";
    var sessionKey = ViewBag.SessionKey;
    var secilenIds = ViewBag.SecilenIds;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .navbar-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .btn-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Sorular", "Soru", new { sessionKey })">
                <i class="fas fa-arrow-left"></i> Geri
            </a>
            <span class="navbar-text text-white">
                <h5 class="mb-0">📦 Soruları Taşı</h5>
            </span>
        </div>
    </nav>

    <div class="container">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5><i class="fas fa-exchange-alt"></i> Yeni Soru Bankasına Taşı</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    <i class="fas fa-info-circle"></i>
                    Seçili sorular yeni bir soru bankası dosyasına taşınacak ve bu bankadan silinecektir.
                </p>

                <form method="post" asp-action="TasimaYap">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sessionKey" value="@sessionKey" />
                    <input type="hidden" name="secilenIds" value="@secilenIds" />

                    <div class="mb-3">
                        <label class="form-label">Yeni Banka Adı *</label>
                        <input type="text" name="yeniBankaAdi" class="form-control"
                               placeholder="Örn: Matematik Soruları - Çarpanlar" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea name="aciklama" class="form-control" rows="2"
                                  placeholder="İsteğe bağlı açıklama"></textarea>
                    </div>

                    <div class="alert alert-warning">
                        <strong><i class="fas fa-exclamation-triangle"></i> Dikkat:</strong>
                        <ul class="mb-0">
                            <li>Seçili sorular mevcut bankadan silinecek</li>
                            <li>Yeni banka dosyası (.mg) otomatik indirilecek</li>
                            <li>İşlem geri alınamaz</li>
                        </ul>
                    </div>

                    <div class="text-end">
                        <a href="@Url.Action("Sorular", "Soru", new { sessionKey })" class="btn btn-secondary">
                            <i class="fas fa-times"></i> İptal
                        </a>
                        <button type="submit" class="btn btn-gradient">
                            <i class="fas fa-arrow-right"></i> Taşı ve İndir
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>