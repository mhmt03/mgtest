@model List<mgtest.Models.Soru>
@{
    ViewData["Title"] = "Sorular";
    var sessionKey = ViewBag.SessionKey ?? "";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Sorular</h1>
        <div>
            <a href="@Url.Action("Create", "Soru", new { sessionKey })" class="btn btn-primary">Yeni Soru Ekle</a>
            <a href="@Url.Action("Index", "mgtest")" class="btn btn-secondary">Geri</a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">Henüz soru eklenmemiþ.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Soru Metni</th>
                        <th>Zorluk</th>
                        <th>Ýþaretli</th>
                        <th>Ýþlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var soru in Model)
                    {
                        <tr>
                            <td>@soru.Id</td>
                            <td>@(soru.SoruMetni.Length > 50 ? soru.SoruMetni.Substring(0, 50) + "..." : soru.SoruMetni)</td>
                            <td><span class="badge bg-info">@soru.ZorlukSeviye</span></td>
                            <td>@(soru.IsaretliMi ? "?" : "-")</td>
                            <td>
                                <a href="@Url.Action("Edit", "Soru", new { id = soru.Id })" class="btn btn-sm btn-warning">Düzenle</a>
                                <button onclick="toggleMark(@soru.Id)" class="btn btn-sm btn-info">Ýþaretle</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
function toggleMark(id) {
    fetch('/Soru/ToggleMark/' + id, { method: 'POST' })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                location.reload();
            }
        });
}
</script>
