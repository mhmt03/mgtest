@model mgtest.Models.Kullanici
@{
    ViewData["Title"] = "Kayýt Ol";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Soru Bankasý</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .register-container {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            max-width: 500px;
            width: 100%;
        }

        .register-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .register-header h2 {
                color: #667eea;
                font-weight: bold;
            }

        .btn-register {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            width: 100%;
            padding: 12px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-header">
            <h2>?? Soru Bankasý</h2>
            <p class="text-muted">Yeni hesap oluþturun</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Register" asp-controller="Account">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Ad" class="form-label">Ad</label>
                    <input asp-for="Ad" class="form-control" required />
                    <span asp-validation-for="Ad" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Soyad" class="form-label">Soyad</label>
                    <input asp-for="Soyad" class="form-control" required />
                    <span asp-validation-for="Soyad" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="KullaniciAdi" class="form-label">Kullanýcý Adý</label>
                <input asp-for="KullaniciAdi" class="form-control" required />
                <span asp-validation-for="KullaniciAdi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Sifre" class="form-label">Þifre</label>
                <input asp-for="Sifre" type="password" class="form-control" required minlength="6" />
                <span asp-validation-for="Sifre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="sifreTekrar" class="form-label">Þifre Tekrar</label>
                <input type="password" class="form-control" id="sifreTekrar" name="sifreTekrar" required minlength="6" />
            </div>

            <button type="submit" class="btn btn-primary btn-register">Kayýt Ol</button>
        </form>

        <div class="text-center mt-3">
            <p class="text-muted">Zaten hesabýnýz var mý?</p>
            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary">Giriþ Yap</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>